# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Any OpenAI-compatible chat-completions endpoint works, for example:
#   vLLM / SGLang:  MTA_BASE_URL=http://localhost:8000/v1   MTA_MODEL=<served model name>
#   Ollama:         MTA_BASE_URL=http://localhost:11434/v1  MTA_MODEL=qwen3.5:9b
#   Hosted APIs:    the provider's OpenAI-compatible base URL and model id
MTA_BASE_URL=
MTA_MODEL=
MTA_API_KEY=

# Optional
# MTA_TEMPERATURE=0.6
# MTA_MAX_TOKENS=32768
# MTA_LOGPROBS=true                          # request logprobs (for RL; needs server support)
# MTA_EXTRA_BODY={"top_k": 20}               # extra request fields, e.g. vLLM sampling params

# Cloud sandboxes for Harbor (only the backend you use)
# DAYTONA_API_KEY=
